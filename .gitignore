# Voice models are large (~70MB) and reproducible via scripts/install_voice.sh
voices/*.onnx
voices/*.onnx.json
voices/MODEL_CARD
voices/*.tar.gz

# Distribution audio now lives in GitHub Releases (one release per
# episode, tagged ep-NNN), NOT in git — this keeps large binaries out of
# history and off GitHub Pages. The render pipeline uploads episode.mp3
# to its release; build_site.py points the feed/pages at the release URL.
episodes/*/episode.mp3
docs/episodes/*/episode.mp3

# Per-paragraph intermediate WAVs — kept on disk for incremental re-rendering
# but not worth versioning.
episodes/*/segments/

# Uncompressed intermediate audio. The MP3 in the same directory is what
# we publish; the WAV is a 70MB intermediate not worth versioning.
episodes/*/episode.wav
episodes/*/preview.wav

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store
